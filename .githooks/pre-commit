#!/bin/sh
# 提交前门禁：扫描暂存区里的敏感信息。
#
# 启用方式（在仓库根目录执行一次）：
#   git config core.hooksPath .githooks
#
# 临时跳过（确认无误时）：
#   git commit --no-verify
set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: 未找到 node，跳过敏感信息扫描" >&2
  exit 0
fi

if [ ! -f scripts/scan-secrets.mjs ]; then
  echo "pre-commit: 缺少 scripts/scan-secrets.mjs，跳过扫描" >&2
  exit 0
fi

# Git for Windows 的 sh 给的是 POSIX 路径（/d/Git/cmd/git），Node 的 spawn 认不了。
# 这里换算成 Windows 绝对路径传给扫描器，避免它在钩子里 ENOENT。
if command -v git >/dev/null 2>&1; then
  git_bin="$(command -v git)"
  if command -v cygpath >/dev/null 2>&1; then
    git_bin="$(cygpath -w "$git_bin")"
  fi
  DSH_GIT_EXECUTABLE="$git_bin"
  export DSH_GIT_EXECUTABLE
fi

exec node scripts/scan-secrets.mjs